#!/usr/bin/env python3
"""A small, inspectable command driver; all compilation and execution is real Go."""
import datetime,json,os,pathlib,resource,subprocess,sys,time
root=pathlib.Path(__file__).resolve().parent
sdk=pathlib.Path(os.environ.get('FOUNDRY_GO_SDK') or (root/'.sdk-path').read_text().strip()) if (os.environ.get('FOUNDRY_GO_SDK') or (root/'.sdk-path').exists()) else None
if not sdk or not (sdk/'bin/go').is_file():raise SystemExit('Run ./setup after uploading the pinned Go SDK.')
allowed={'hello':'./cmd/hello','channels':'./cmd/channels','db-insert':'./cmd/tinydb','db-read':'./cmd/tinydb','test':None}
name=sys.argv[1] if len(sys.argv)>1 else ''
if name not in allowed:raise SystemExit('Choose: ./run hello | channels | test | db-insert | db-read')
cache=pathlib.Path((root/'.cache-path').read_text().strip()) if (root/'.cache-path').exists() else root/'.go-cache'
cache.mkdir(parents=True,exist_ok=True)
# The immutable image cache has reproducible old mtimes. This short-lived VM
# keeps its prepared entries until Stop; do not trim them on the first command.
(cache/'trim.txt').write_text(str(int(time.time()))+'\n')
env=dict(os.environ,GOROOT=str(sdk),GOTOOLCHAIN='local',CGO_ENABLED='0',GOAMD64='v1',GOMAXPROCS='1',GOGC='50',GOCACHE=str(cache),GOPATH=str(root/'.go-path'),GOPROXY='off',GOSUMDB='off')
(root/'.bin').mkdir(exist_ok=True);(root/'data').mkdir(exist_ok=True)
started=time.monotonic();build_seconds=0;run_seconds=0
print('Running Go tests…' if name=='test' else 'Building '+name+' with the Go compiler…',flush=True)
try:
 if name=='test':
  result=subprocess.run([str(sdk/'bin/go'),'test','-p=1','-buildvcs=false','-trimpath','-count=1','-timeout=60s','./...'],cwd=root,env=env,text=True,capture_output=True,timeout=600)
  build_seconds=time.monotonic()-started
 else:
  output=root/'.bin'/('tinydb' if name.startswith('db-') else name)
  result=subprocess.run([str(sdk/'bin/go'),'build','-p=1','-buildvcs=false','-trimpath','-o',str(output),allowed[name]],cwd=root,env=env,text=True,capture_output=True,timeout=600)
  build_seconds=time.monotonic()-started
  if result.stdout:print(result.stdout,end='')
  if result.stderr:print(result.stderr,end='',file=sys.stderr)
  if result.returncode==0:
   command=[str(output)]
   if name=='db-insert':command+=['data/people.gdb','insert','7','Ada','42']
   if name=='db-read':command+=['data/people.gdb','get','7']
   execution=time.monotonic();result=subprocess.run(command,cwd=root,env=env,text=True,capture_output=True,timeout=60);run_seconds=time.monotonic()-execution
 if result.stdout:print(result.stdout,end='')
 if result.stderr:print(result.stderr,end='',file=sys.stderr)
 record={'case':name,'exit_code':result.returncode,'build_or_test_seconds':round(build_seconds,3),'program_seconds':round(run_seconds,3),'total_seconds':round(time.monotonic()-started,3),'max_child_process_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'utc':datetime.datetime.now(datetime.timezone.utc).isoformat()}
 with (root/'measurements.jsonl').open('a',encoding='utf-8') as file:file.write(json.dumps(record)+'\n')
 print('Measurement:',json.dumps(record),flush=True)
 sys.exit(result.returncode)
except subprocess.TimeoutExpired:raise SystemExit('Command exceeded its time limit. Existing data is kept; inspect the program before retrying.')
