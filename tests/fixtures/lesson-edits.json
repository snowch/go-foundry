{
  "print-values": [
    {
      "before": "2+3",
      "after": "2*3",
      "expected": "sum 6\nproduct 12"
    }
  ],
  "formatted-output": [
    {
      "before": "%.2f",
      "after": "%.1f",
      "expected": "Ada has 3 items; price 2.3"
    }
  ],
  "quoted-and-raw-strings": [
    {
      "before": "`first\\nsecond`",
      "after": "`first\nsecond`",
      "expected": "quoted:\nfirst\nsecond\nraw:\nfirst\nsecond"
    }
  ],
  "assignment": [
    {
      "before": "count = count + 2",
      "after": "count = count * 2",
      "expected": "before 3\nafter 6"
    }
  ],
  "constants": [
    {
      "before": "itemsPerBox = 4",
      "after": "itemsPerBox = 6",
      "expected": "total items 18"
    }
  ],
  "zero-values": [
    {
      "before": "name = \"\"",
      "after": "name = \"Ada\"",
      "expected": "count=0 ready=false name=\"Ada\""
    }
  ],
  "number-conversions": [
    {
      "before": "value := 3.9",
      "after": "value := -3.9",
      "expected": "decimal -3.9\ninteger -3"
    }
  ],
  "bounded-integers": [
    {
      "before": "value uint8 = 255",
      "after": "value uint8 = 254",
      "expected": "after increment 255"
    }
  ],
  "boolean-logic": [
    {
      "before": "attendance := 75",
      "after": "attendance := 90",
      "expected": "eligible true"
    }
  ],
  "else-if": [
    {
      "before": "temperature := 0",
      "after": "temperature := -1",
      "expected": "freezing"
    }
  ],
  "switch": [
    {
      "before": "operation := \"add\"",
      "after": "operation := \"subtract\"",
      "expected": "result 3"
    }
  ],
  "condition-loop": [
    {
      "before": "remaining := 3",
      "after": "remaining := 0",
      "expected": "launch"
    }
  ],
  "break-and-continue": [
    {
      "before": "value == 5",
      "after": "value == 4",
      "expected": "1\n3"
    }
  ],
  "integer-range": [
    {
      "before": "count := 3",
      "after": "count := 0",
      "expected": "done"
    }
  ],
  "function-result": [
    {
      "before": "value * 2",
      "after": "value * 3",
      "expected": "result 9"
    }
  ],
  "multiple-results": [
    {
      "before": "divide(8, 3)",
      "after": "divide(9, 3)",
      "expected": "quotient 3 remainder 0"
    }
  ],
  "scope-and-shadowing": [
    {
      "before": "value := 3",
      "after": "value = 3",
      "expected": "inner 3\nouter 3"
    }
  ],
  "value-and-pointer": [
    {
      "before": "*value + 1",
      "after": "*value + 5",
      "expected": "after value 3\nafter pointer 8"
    }
  ],
  "function-values": [
    {
      "before": "apply(4, double)",
      "after": "apply(4, triple)",
      "expected": "applied 12"
    }
  ],
  "closures": [
    {
      "before": "count := 0",
      "after": "count := 10",
      "expected": "first 11 second 12\nother 11"
    }
  ],
  "defer-order": [
    {
      "before": "defer fmt.Println(\"cleanup\")",
      "after": "fmt.Println(\"cleanup\")",
      "expected": "cleanup\nwork\nfinished"
    }
  ],
  "recursion": [
    {
      "before": "sumTo(4)",
      "after": "sumTo(5)",
      "expected": "total 15"
    }
  ],
  "function-practice": [
    {
      "before": "if value > limit {",
      "after": "if value < 0 { return 0 }; if value > limit {",
      "expected": "low 0 middle 3 high 5"
    }
  ],
  "arrays": [
    {
      "before": "values[1] = 9",
      "after": "values[0] = 9",
      "expected": "[9 4 6]"
    }
  ],
  "slice-bounds": [
    {
      "before": "values[1:3]",
      "after": "values[1:4]",
      "expected": "len 3 values [4 6 8]"
    }
  ],
  "append-capacity": [
    {
      "before": "make([]int, 2, 4)",
      "after": "make([]int, 2, 2)",
      "expected": "before 2 2\nafter length 4 grew true\nvalues [0 0 7 8]"
    }
  ],
  "slice-aliases": [
    {
      "before": "left[1] = 9",
      "after": "right[1] = 9",
      "expected": "left [2 4]\nbacking [2 4 9]\nright [4 9]"
    }
  ],
  "copy-slices": [
    {
      "before": "copied[0] = 9",
      "after": "copied[1] = 9",
      "expected": "copied count 3\noriginal [2 4 6]\ncopy [2 9 6]"
    }
  ],
  "map-lookup": [
    {
      "before": "scores[\"Ada\"]",
      "after": "scores[\"Grace\"]",
      "expected": "value=0 found=false"
    }
  ],
  "map-delete-and-order": [
    {
      "before": "delete(scores, \"Ada\")",
      "after": "delete(scores, \"Grace\")",
      "expected": "names [Ada Lin]"
    }
  ],
  "unicode-text": [
    {
      "before": "text := \"éGo\"",
      "after": "text := \"Go\"",
      "expected": "bytes 2 runes 2\n0:G\n1:o"
    }
  ],
  "text-fields": [
    {
      "before": "text := \"  Ada   Lin \"",
      "after": "text := \"  Ada Grace  Lin \"",
      "expected": "words 3 [Ada Grace Lin]\nnormalized=\"Ada Grace Lin\""
    }
  ],
  "variadic-functions": [
    {
      "before": "[]int{4, 5}",
      "after": "[]int{4, 5, 6}",
      "expected": "literal 6\nslice 15"
    }
  ],
  "word-count-practice": [
    {
      "before": "counts[word]++",
      "after": "counts[strings.ToLower(word)]++",
      "expected": "go 3 Go 0"
    }
  ],
  "struct-values": [
    {
      "before": "moved.X = 9",
      "after": "point.X = 9",
      "expected": "original {9 3}\nmoved {2 3}"
    }
  ],
  "value-methods": [
    {
      "before": "Width: 3",
      "after": "Width: 5",
      "expected": "area 20"
    }
  ],
  "pointer-methods": [
    {
      "before": "(c *Counter)",
      "after": "(c Counter)",
      "expected": "value 3"
    }
  ],
  "named-types": [
    {
      "before": "Seconds(3)",
      "after": "Metres(3)",
      "expected": null
    }
  ],
  "implicit-interfaces": [
    {
      "before": "Greeter{Name: \"Ada\"}",
      "after": "Message{Text: \"Ready\"}",
      "expected": "Ready"
    }
  ],
  "embedding": [
    {
      "before": "fmt.Println(\"promoted\", person.City, \"nested\", person.Address.City)",
      "after": "person.City = \"Paris\"\nfmt.Println(\"promoted\", person.City, \"nested\", person.Address.City)",
      "expected": "promoted Paris nested Paris"
    }
  ],
  "type-assertions": [
    {
      "before": "var value any = \"Ada\"",
      "after": "var value any = 42",
      "expected": "text=\"\" ok=false"
    }
  ],
  "type-switch": [
    {
      "before": "describe(7)",
      "after": "describe(\"Ada\")",
      "expected": "text \"Ada\""
    }
  ],
  "nil-interfaces": [
    {
      "before": "var value any = pointer",
      "after": "var value any = nil",
      "expected": "pointer nil true\ninterface nil true"
    }
  ],
  "generic-functions": [
    {
      "before": "right int64 = 5",
      "after": "right int64 = 7",
      "expected": "int 5\nint64 11"
    }
  ],
  "generic-sets": [
    {
      "before": "names.Add(\"go\")",
      "after": "names.Add(\"rust\")",
      "expected": "go false rust true"
    }
  ],
  "enum-constants": [
    {
      "before": "= iota",
      "after": "= iota + 1",
      "expected": "idle 1 working 2 done 3"
    }
  ],
  "error-values": [
    {
      "before": "nonNegative(-2)",
      "after": "nonNegative(2)",
      "expected": "value 2"
    }
  ],
  "wrapped-errors": [
    {
      "before": "lookup: %w",
      "after": "lookup: %v",
      "expected": "lookup: missing\nmissing false"
    }
  ],
  "typed-errors": [
    {
      "before": "Limit: 3",
      "after": "Limit: 5",
      "expected": "limit 5"
    }
  ],
  "validation-guards": [
    {
      "before": "score := 101",
      "after": "score := 100",
      "expected": "valid 100"
    }
  ],
  "panic-and-recover": [
    {
      "before": "panic(\"stop\")",
      "after": "fmt.Println(\"work\")",
      "expected": "work\ncontinued"
    }
  ],
  "packages-and-exports": [
    {
      "before": "lessonmath.Double(4)",
      "after": "lessonmath.double(4)",
      "expected": null
    }
  ],
  "unit-tests": [
    {
      "before": "want := 6",
      "after": "want := 7",
      "expected": {
        "contains": "FAIL",
        "exit": 1
      }
    }
  ],
  "table-tests": [
    {
      "before": "{\"high\", 11, 10},",
      "after": "{\"high\", 11, 10},\n{\"at limit\", 10, 10},",
      "expected": "PASS"
    }
  ],
  "test-dependencies": [
    {
      "before": "loadLabel(fakeSource{value: \"Ada\"}); got != \"loaded Ada\"",
      "after": "loadLabel(fakeSource{failed: true}); got != \"unavailable\"",
      "expected": "PASS"
    }
  ],
  "fuzz-seeds": [
    {
      "before": "f.Add(\"  Ada \")",
      "after": "f.Add(\"\\tLin\\n\")",
      "expected": "PASS"
    }
  ],
  "benchmark-harness": [
    {
      "before": "[]int{1, 2, 3}",
      "after": "[]int{1, 2, 3, 4}",
      "expected": "PASS"
    }
  ]
}
