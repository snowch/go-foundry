#!/usr/bin/env python3
"""Prepare an uploaded, checksum-pinned Go SDK without guest network access."""
import hashlib,json,os,pathlib,subprocess,sys,tarfile,time
root=pathlib.Path(__file__).resolve().parent
manifest=json.loads((root/'tools/go-toolchain.json').read_text())
archive=pathlib.Path(sys.argv[1]) if len(sys.argv)>1 else pathlib.Path.home()/manifest['file']['filename']
prefix=pathlib.Path('/opt/go-foundry')
expected=manifest['file']['sha256']
if not archive.is_file():raise SystemExit('Upload '+manifest['file']['filename']+' using the terminal upload control, then run ./setup again.')
print('Verifying the uploaded Go archive…',flush=True);started=time.monotonic();digest=hashlib.sha256()
with archive.open('rb') as file:
 while chunk:=file.read(1024*1024):digest.update(chunk)
if digest.hexdigest()!=expected:raise SystemExit('Go archive checksum mismatch. The existing SDK was kept. Download the pinned archive again.')
marker=prefix/'archive.sha256'
if marker.exists() and marker.read_text().strip()==expected and (prefix/'go/bin/go').exists():
 print('Using the already prepared, verified Go SDK.',flush=True)
else:
 print('Unpacking the verified Go SDK with Linux tar…',flush=True)
 prefix.mkdir(parents=True,exist_ok=True)
 # This is the exact official archive verified above, not an arbitrary upload.
 subprocess.run(['tar','xzf',str(archive),'-C',str(prefix)],check=True)
 marker.write_text(expected+'\n')
(root/'.sdk-path').write_text(str(prefix/'go')+'\n')
print(subprocess.check_output([str(prefix/'go/bin/go'),'version'],text=True).strip())
print(f'Setup seconds: {time.monotonic()-started:.3f}')
print('Ready. Run ./run hello. Each command rebuilds edited source before executing it.')
